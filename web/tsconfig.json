{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    // No `baseUrl`: TypeScript 7 removed it. The mapping below is unchanged in effect — `paths`
    // entries have always been resolved relative to this file when baseUrl is absent, and these
    // were already written as `./`-relative.
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
