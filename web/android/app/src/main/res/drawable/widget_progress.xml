<?xml version="1.0" encoding="utf-8"?>
<!-- HabitProgress: a `bg-muted` track with a `bg-primary` fill, 1.5 units tall and fully rounded.
     A layer-list rather than a tint applied from Java, so values-night resolves in the launcher's
     process - see the note in layout/widget_habits.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_primary_soft" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
