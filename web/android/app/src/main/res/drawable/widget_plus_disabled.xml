<?xml version="1.0" encoding="utf-8"?>
<!-- Disabled: the same lucide glyph at half strength, matching shadcn's
     `disabled:opacity-50`. A disabled stepper keeps its place in the row rather than vanishing,
     for the reason HabitControl disables rather than unmounts: a control that disappears shifts
     the row out from under the finger about to press something else.
     lucide widget_plus. Stroked, 2px, round caps - the same geometry the app renders, so the
     widget and the day card are drawing one icon set rather than two similar ones. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="@color/widget_disabled">
    <path
        android:pathData="M5 12 h14"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path
        android:pathData="M12 5 v14"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="2"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
