<?xml version="1.0" encoding="utf-8"?>
<!-- The strip holding a running session. Filled with `accent` rather than bordered: it is the one
     thing on the card that is actively happening, and a fill separates it from the list below
     without adding a second hairline beside the card's own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_accent" />
    <corners android:radius="10dp" />
</shape>
