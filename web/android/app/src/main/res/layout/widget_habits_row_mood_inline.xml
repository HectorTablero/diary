<?xml version="1.0" encoding="utf-8"?>
<!--
    A mood habit on a widget wide enough for it: name, streak and all five faces on one line — the
    shape MoodControl has on the day card, and the shape every other row in this widget has.

    Chosen by HabitsWidgetFactory from `OPTION_APPWIDGET_MIN_WIDTH`, the width the launcher reports
    for this particular instance rather than anything about the screen. Below the threshold the
    faces drop to a line of their own (widget_habits_row_mood.xml), because five targets squeezed
    beside a label are five targets too small to hit.

    The faces are `wrap_content` here, not weighted: weighting them would stretch five icons across
    whatever room a short habit name left over, so the control's width would depend on the length of
    the word next to it and no two mood rows would line up.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/widget_row_gap"
    android:paddingBottom="@dimen/widget_row_gap">

    <TextView
        android:id="@+id/row_label_done"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:fontFamily="@font/geist_sans"
        android:textColor="@color/widget_foreground" />

    <TextView
        android:id="@+id/row_label_todo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:fontFamily="@font/geist_sans"
        android:textColor="@color/widget_muted" />

    <LinearLayout
        android:id="@+id/row_streak_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/widget_streak_badge">

        <ImageView
            android:scaleType="fitCenter"
                android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/widget_flame"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/row_streak_count_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/geist_sans"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_streak" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_streak_todo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/widget_streak_badge_muted">

        <ImageView
            android:scaleType="fitCenter"
                android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/widget_flame_muted"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/row_streak_count_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/geist_sans"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp">

        <ImageView android:id="@+id/row_face_1"
            android:layout_width="@dimen/widget_face" android:layout_height="@dimen/widget_face"
            android:scaleType="fitCenter" android:src="@drawable/widget_face_1_off"
            android:contentDescription="@string/widget_habits_rate" />
        <ImageView android:id="@+id/row_face_2"
            android:layout_width="@dimen/widget_face" android:layout_height="@dimen/widget_face"
            android:scaleType="fitCenter" android:src="@drawable/widget_face_2_off"
            android:contentDescription="@string/widget_habits_rate" />
        <ImageView android:id="@+id/row_face_3"
            android:layout_width="@dimen/widget_face" android:layout_height="@dimen/widget_face"
            android:scaleType="fitCenter" android:src="@drawable/widget_face_3_off"
            android:contentDescription="@string/widget_habits_rate" />
        <ImageView android:id="@+id/row_face_4"
            android:layout_width="@dimen/widget_face" android:layout_height="@dimen/widget_face"
            android:scaleType="fitCenter" android:src="@drawable/widget_face_4_off"
            android:contentDescription="@string/widget_habits_rate" />
        <ImageView android:id="@+id/row_face_5"
            android:layout_width="@dimen/widget_face" android:layout_height="@dimen/widget_face"
            android:scaleType="fitCenter" android:src="@drawable/widget_face_5_off"
            android:contentDescription="@string/widget_habits_rate" />
    </LinearLayout>
</LinearLayout>
