<?xml version="1.0" encoding="utf-8"?>
<!--
    A habit whose stopwatch is running, lifted out of the list.

    Deliberately the same row as widget_habits_row.xml's duration case — same 14sp label, same
    streak badge, the same four controls in the same order (pause, −, value, +) at the same 28dp,
    the same goal bar underneath. It is not a summary of the row; it *is* the row, drawn somewhere
    else, and the factory drops the habit from the collection while it runs so the two never appear
    at once. What the user sees is a row that moved up.

    ## Why it lives outside the list

    A Chronometer keeps time by posting itself a message each second while started, visible and
    shown. Inside a collection item the launcher's RemoteViewsAdapter owns the view's lifecycle and
    recycles it, and the ticking does not survive that — which is why the in-row clock only moved
    when something re-applied the whole RemoteViews, on a pause or a resize. Added with
    `RemoteViews.addView` into a container in the widget's own root, this is an ordinary view in the
    launcher's hierarchy and ticks like any other widget clock.

    `addView` also means there can be several: nothing stops two habits being timed at once, and one
    strip per running session costs only the space it takes. The list below has `layout_weight="1"`
    and yields it.

    ## The steppers are drawn, not removed

    TimeControl disables `−` and `+` while a session runs — editing a number a clock is currently
    writing to is the one edit that cannot be reconciled — and disabling rather than unmounting is
    its explicit choice, so that starting a timer does not reflow the row out from under the finger
    that started it. Same here: the half-strength glyphs hold their place, and carry no click intent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/widget_row_gap"
    android:paddingBottom="@dimen/widget_row_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Always full strength: a running session means `live.total > 0`, which is HabitRow's own
             condition for an undimmed name. -->
        <TextView
            android:id="@+id/session_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:fontFamily="@font/geist_sans"
            android:textColor="@color/widget_foreground" />

        <LinearLayout
            android:id="@+id/session_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginStart="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_streak_badge">

            <ImageView
                android:scaleType="fitCenter"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/widget_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/session_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="@font/geist_sans"
                android:textFontWeight="500"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_streak" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp">

            <!-- `variant="default"` while running: the one control actually doing something is the
                 only filled thing in the row. -->
            <ImageButton
                android:id="@+id/session_pause"
                android:scaleType="fitCenter"
                android:layout_width="@dimen/widget_button"
                android:layout_height="@dimen/widget_button"
                android:padding="@dimen/widget_button_inset"
                android:src="@drawable/widget_pause"
                android:background="@drawable/widget_timer_running"
                android:contentDescription="@string/widget_habits_pause" />

            <ImageView
                android:scaleType="fitCenter"
                android:layout_width="@dimen/widget_button"
                android:layout_height="@dimen/widget_button"
                android:padding="@dimen/widget_button_inset"
                android:src="@drawable/widget_minus_disabled"
                android:contentDescription="@null" />

            <!-- The value slot, ticking. `font-medium text-primary` — what TimeControl switches the
                 number to while a timer runs. -->
            <Chronometer
                android:id="@+id/session_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textSize="14sp"
                android:fontFamily="@font/geist_sans"
                android:textFontWeight="500"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_primary" />

            <ImageView
                android:scaleType="fitCenter"
                android:layout_width="@dimen/widget_button"
                android:layout_height="@dimen/widget_button"
                android:padding="@dimen/widget_button_inset"
                android:src="@drawable/widget_plus_disabled"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/session_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
