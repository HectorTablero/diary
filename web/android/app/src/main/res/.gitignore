# Ignore generated density-specific launcher assets.
mipmap-ldpi
mipmap-mdpi
mipmap-hdpi
mipmap-xhdpi
mipmap-xxhdpi
mipmap-xxxhdpi

# Written by generateNotificationIcon in web/scripts/generateAssets.ts, whose shape is chosen by
# NOTIFICATION_ICON_LOGO in shared/src/constants.ts. Committing it would let the tracked copy and
# that constant disagree; `npm run build:app` regenerates it before every APK.
#
# (Its sibling drawable/ic_splash.xml is generated by the same script but stays tracked on purpose:
# values/styles.xml references it by name, so a tree that hasn't run the generator yet would fail to
# compile rather than fall back to something.)
drawable/ic_stat_notify.xml
