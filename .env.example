# Copy to .env and fill in. Nothing here is a secret — it is the shape of the file,
# not a working configuration.
#
# The server reads this file from the repo root (server/src/config.ts), and so does
# Vite (web/vite.config.ts), which is why one file covers both workspaces.

# ── Required ──────────────────────────────────────────────────────────────────
# The server refuses to start without these three: config.ts calls required() and
# throws by name on the first one missing.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Add these redirect URIs to that client:
#   http://localhost:5173/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google   (prod)
# The client id is also exposed to the bundle as VITE_GOOGLE_CLIENT_ID for the
# Android app's native sign-in — vite.config.ts copies it across, so don't set
# that one by hand. The secret stays server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs Better Auth's session cookies and bearer tokens. Generate one with:
#   openssl rand -base64 32
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=

# ── Optional, with defaults ───────────────────────────────────────────────────

# Defaults to mongodb://127.0.0.1:27017/diary
MONGODB_URI=mongodb://127.0.0.1:27017/diary

# The API port. Vite proxies /api here in dev. Defaults to 3000.
PORT=3000

# The public origin, used as Better Auth's baseURL and as the allowed CORS origin.
# Defaults to http://localhost:5173, which is the Vite dev server.
# MUST be set to the real origin in production.
BETTER_AUTH_URL=http://localhost:5173

# Swaps in a distinct favicon and a [DEV] title prefix so a dev tab is never
# mistaken for the real one. Any value other than 'true' is off.
IS_LOCAL_DEVELOPMENT=true

# ── Android App Links (optional) ──────────────────────────────────────────────
# Lets a link to this site open the Android app instead of the browser.
#
# The server answers /.well-known/assetlinks.json with these, and Android checks the result against
# the certificate the installed APK was signed with. Leave it unset and links still work — they
# just show a chooser or go to the browser, and the route 404s.
#
# SHA-256 fingerprints, exactly as `keytool` prints them (32 colon-separated hex bytes). Space- or
# comma-separated for more than one; list the debug keystore's too if you want debug builds to open
# links as well. Anything that isn't in that form is ignored with a warning — the easy mistake is
# pasting the SHA-1 line, which sits directly above it in the output.
#
#   keytool -list -v -keystore web/android/app/diary-release.keystore -alias <alias>
#
# Not secret: the same fingerprint is inside every copy of the APK.
ANDROID_CERT_FINGERPRINTS=

# ── Telemetry (optional) ──────────────────────────────────────────────────────
# Better Stack error and metrics reporting. Leave every one of these unset and
# both the server and the client log to the console only — no account needed.
#
# Create TWO sources at https://telemetry.betterstack.com (Sources → Connect
# source). The client token ships inside the web bundle and must not be the
# server's. Both values are on each source's Configure screen.

# Source platform: JavaScript. Inlined into the web bundle at BUILD time, so it
# must be present when `npm run build` runs — setting it at runtime does nothing.
VITE_BETTERSTACK_SOURCE_TOKEN=
VITE_BETTERSTACK_INGEST_URL=

# Source platform: Node.js. Read by the server at RUNTIME, so this pair belongs
# wherever the container's environment is configured — not at image build time.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_URL=
